# 데스크톱 frontend/.env와 같은 이름·값 (shared/env.js가 읽음)
VITE_API_BASE_URL=http://localhost:4000
# 로비 고객센터 디스코드 주소 (비우면 고객센터 버튼 안 씀)
VITE_DISCORD_SUPPORT_URL=
# 광고 (비우면 운영에선 광고 없음, 개발 서버에선 회색 "광고 자리" 상자만). 설정 방법: docs/모바일-광고/설정.md
# 공급자: adsense 또는 비움
VITE_AD_PROVIDER=
# AdSense 광고 계정 번호 (ca-pub-로 시작)
VITE_ADSENSE_CLIENT=
# 광고 단위 번호: 하단 배너(320×50) / 한 판 끝 창(반응형)
VITE_ADSENSE_SLOT_BANNER=
VITE_ADSENSE_SLOT_INTERSTITIAL=
