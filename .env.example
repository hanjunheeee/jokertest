# 이 파일을 .env로 복사한 뒤 값을 채워서 씁니다(cp .env.example .env).
# .env는 .gitignore에 걸려 있어 커밋되지 않습니다. 여기 적힌 값은 전부 예시이며
# 실제 비밀 값이 아닙니다.
#
# docker compose는 루트 .env를 ${VAR} 보간에 자동으로 사용하고,
# backend 컨테이너엔 이 파일을 env_file로 통째로 넘깁니다(docker-compose.yml).
# 그래서 메일·소셜 로그인·INTERNAL_API_KEY·SIGNUP_EMAIL_HMAC_SECRET 같은 백엔드 값도 여기에 같이 넣습니다
# (이름·설명은 backend/.env.example). PORT·LOG_DIR·SERVER_ID·REDIS_URL은 compose가 정해 넣어서 여기 값이 안 먹습니다(NODE_ENV는 비면 production).
# 시험 전용 값(GOOGLE_OAUTH_BASE_URL·DISCORD_OAUTH_BASE_URL·TOSS_API_BASE_URL·E2E_HOOKS·MAIL_TEST_OUTBOX_DIR)은
# 운영(.env.production)에 절대 넣지 않습니다 — 넣으면 서버가 안 켜집니다(docs/배포_설정.md 9-5).

# ─────────────────────────────────────────────
# MySQL 컨테이너(db 서비스)
# ─────────────────────────────────────────────
MYSQL_DATABASE=joker
MYSQL_USER=joker
MYSQL_PASSWORD=change-me-user-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ─────────────────────────────────────────────
# backend
# ─────────────────────────────────────────────
# Sequelize가 그대로 파싱하는 접속 URL입니다(backend/config/config.json의 use_env_variable).
# compose로 띄울 때 호스트 이름은 db 서비스 이름인 "db"이고, 로컬에서 직접 실행할 때는
# localhost입니다. 사용자·비밀번호·DB 이름은 위 MYSQL_* 값과 일치해야 합니다.
DATABASE_URL=mysql://joker:change-me-user-password@db:3306/joker

# JWT 서명 키. 반드시 배포 환경마다 다른 임의의 긴 문자열로 바꿉니다.
# 값이 없으면 토큰 발급 시점에 곧바로 에러가 납니다(backend/utils/jwt.js).
JWT_SECRET=change-me-to-a-long-random-string

# CORS 허용 origin이자 쿠키 인증이 오갈 프론트엔드 주소입니다(backend/index.js).
# 로컬 개발은 http://localhost:5173, compose로 띄우면 아래 WEB_PORT와 맞춥니다.
FRONTEND_URL=http://localhost:8080

# 모바일 프론트엔드 주소입니다(backend/config/frontendOrigins.js). 비워 두면 데스크톱만 허용합니다.
# 넣으면 CORS 허용 목록에 더해지고, client=mobile로 시작한 소셜 로그인이 이 주소로 돌아갑니다.
FRONTEND_MOBILE_URL=

# 백엔드가 listen할 포트입니다. 비워 두면 4000을 씁니다.
PORT=4000

# production이면 공식 매칭 규칙이 적용되고, 그 외에는 개발용 규칙이 적용됩니다.
# 로컬 docker는 development 그대로 둡니다 (production이면 쿠키가 https 전용이라 http://localhost에서 로그인이 안 됨).
# 운영 서버는 이 파일 말고 .env.production(값 production)을 따로 만들어 씁니다.
NODE_ENV=development

# 토스페이먼츠 키(backend/utils/adapters/toss.js). 운영(production)은 운영 키(live_ck_·live_sk_)를 쓰고,
# 운영 키를 비워 두면 시험 키(test_ck_·test_sk_)로 돌며 켤 때 경고를 남깁니다(결제해도 돈이 안 들어옴).
# 개발·시험은 시험 키만 씁니다. 비밀 키는 서버에만 둡니다.
TOSS_LIVE_CLIENT_KEY=
TOSS_LIVE_SECRET_KEY=
TOSS_TEST_CLIENT_KEY=
TOSS_TEST_SECRET_KEY=

# ─────────────────────────────────────────────
# 선택 값 — 비워 두면 앱 기본값이 그대로 쓰입니다
# ─────────────────────────────────────────────
# 개발 모드(NODE_ENV != production)에서 게임 시작에 필요한 최소 인원입니다. 기본 1.
GAME_DEV_MIN_PLAYERS=1

# Sequelize 커넥션 풀(backend/config/dbPool.js). 기본값은 각각 10 / 0 / 10000 / 30000입니다.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# 개발에서 sequelize 질의를 하나하나 찍어 보려면 1 (운영은 늘 끔, backend/config/dbLogging.js)
DB_LOG_QUERIES=

# 동시 접속 스냅샷 저장 주기(ms). 비정상 값이면 서버 기본값 60000을 사용합니다.
CONCURRENT_SNAPSHOT_INTERVAL_MS=60000

# ─────────────────────────────────────────────
# frontend
# ─────────────────────────────────────────────
# 호스트에서 프론트엔드(nginx)를 열 포트입니다. 기본 8080.
WEB_PORT=8080

# ─────────────────────────────────────────────
# 로그 (선택) — backend 컨테이너 /app/logs에 날짜별 파일, 보관 일수 기본 14
# ─────────────────────────────────────────────
LOG_RETENTION_DAYS=14

# ─────────────────────────────────────────────
# Node 여러 개 · Redis (docs/배포_설정.md 7장)
# ─────────────────────────────────────────────
# Redis 비번: compose가 redis 서비스와 backend REDIS_URL(redis://:비번@redis:6379)에 같이 넣음
# 비워 두면 로컬 전용 기본값으로 켜짐. 운영(.env.production)은 꼭 넣기 (docker-compose.prod.yml이 없으면 멈춤)
# URL에 들어가므로 영문·숫자만 (특수문자는 %인코딩이 필요해 틀리기 쉬움), 32자 이상 권장
REDIS_PASSWORD=

# 띄울 백엔드 Node 수: 배포 생성기(deploy/scripts/gen-nodes.js)·pm2 설정만 읽음 (서버 코드는 안 읽음)
# 비워 두면 코어 수. 되돌리기(단일 Node)는 1
NODE_COUNT=

# MySQL 연결 한도 (서버가 시작 때 NODE_COUNT × DB_POOL_MAX가 이 값의 80%를 넘으면 경고), 기본 151
DB_MAX_CONNECTIONS=

# ─────────────────────────────────────────────
# 관리자 페이지 (docs/배포_설정.md 8장) — 이름만, 값은 운영 .env.production에만
# ─────────────────────────────────────────────
# 관리자 화면 주소 (예: https://admin.<도메인>, 끝 / 없이). 비우면 관리자 쓰기 요청이 전부 막힘
ADMIN_ORIGIN=
# OTP 비밀 잠금 열쇠: 16진수 64자 (openssl rand -hex 32). 비우면 /admin-api 전체 꺼짐
# 한 번 정하면 바꾸지 않기 (바꾸면 이미 만든 관리자 OTP를 못 풂)
ADMIN_TOTP_KEY=
# 클라우드플레어 Access 확인: 비우면 required(켬). off는 운영이 아닐 때만 먹음(로컬 docker 볼 때)
ADMIN_ACCESS_MODE=
# 클라우드플레어 Zero Trust 팀 이름 (예: <팀 이름> → <팀 이름>.cloudflareaccess.com)
ADMIN_ACCESS_TEAM_DOMAIN=
# Access 앱의 AUD 값 (Access 앱 화면 Overview의 Application Audience (AUD) Tag)
# 운영에서 팀 이름·AUD 둘 중 하나라도 비면 /admin-api 전체 꺼짐
ADMIN_ACCESS_AUD=
# 가만히 있으면 자동 로그아웃 되는 분 (비우면 30)
ADMIN_SESSION_IDLE_MIN=
