# backend 환경 변수 예시입니다. 이 파일을 backend/.env로 복사한 뒤 값을 채워 쓰세요.
# 여기 적힌 값은 전부 형식만 보여주는 placeholder이며 실제 비밀값이 아닙니다.
# backend/index.js가 dotenv로 backend/.env를 읽습니다(.env 자체는 커밋 대상이 아닙니다).

# Express 서버 포트. 미설정이면 코드 기본값을 사용합니다(backend/index.js).
PORT=3000

# development / test / production. 미설정이면 development로 봅니다(backend/models/index.js).
# production이 아니면 개발용 매치메이킹 규칙이 적용됩니다(backend/socket/matchmaking.js).
NODE_ENV=development

# CORS·Socket.IO가 허용할 프런트엔드 출처(backend/index.js, backend/socket/socket.js).
FRONTEND_URL=http://localhost:5173

# JWT 서명 키(backend/utils/jwt.js). 배포 환경에서는 반드시 충분히 긴 무작위 값으로 교체하세요.
JWT_SECRET=change-me-to-a-long-random-string

# Sequelize 접속 문자열(backend/config/config.json의 use_env_variable로 참조됨).
DATABASE_URL=mysql://user:password@localhost:3306/database

# 개발 환경에서만 적용되는 게임 시작 최소 인원(backend/socket/matchmaking.js). 미설정이면 1.
# GAME_DEV_MIN_PLAYERS=1

# 테스트 전용 역할 고정 배정. 설정하면 게임 시작 시 참가자 "입장 순서"대로 아래 목록의
# 역할을 그대로 배정하고 셔플하지 않습니다(E2E 시나리오 재현용). 미설정이면 기존 랜덤 배정.
# 목록 길이가 참가자 수와 다르거나, 알 수 없는 역할명이 있거나, 방의 역할 구성과 개수가
# 어긋나면 경고 한 줄을 남기고 랜덤 배정으로 되돌아갑니다(게임은 정상 시작됩니다).
# 사용 가능한 역할: JOKER, CITIZEN, DOCTOR, GUARD, WITCH_HUNTER
# 운영 환경에서는 절대 설정하지 마세요.
# DEBUG_FIXED_ROLES=JOKER,DOCTOR,GUARD,WITCH_HUNTER,CITIZEN
