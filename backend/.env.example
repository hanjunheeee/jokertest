# 백엔드 환경 값 이름 모음 (진짜 값은 backend/.env에만, 이 파일엔 절대 안 넣음)
# 비워 둔 줄은 기본값이 있거나 그 기능을 안 쓸 때 비워도 됨. 설정 방법: docs/이메일_토스_설정.md

# ── 서버 기본 ──
# 서버 포트
PORT=
# MySQL 주소 (mysql://아이디:비밀번호@호스트:포트/DB이름)
DATABASE_URL=
# 로그인 토큰 서명 비밀값 (길고 무작위로)
JWT_SECRET=
# 데스크톱·모바일 화면 주소 (CORS·소셜 로그인 복귀용)
FRONTEND_URL=
FRONTEND_MOBILE_URL=
# 실행 환경 (development·test·production), 로컬은 development 그대로 (빈 값도 개발로 봄, 오타면 시작 거부)
NODE_ENV=development
# 서버 이름 (영문·숫자·_-. 64자까지), 서버 한 대면 비워 둠(기본 main), 여러 대면 서버마다 다르게 · 재시작해도 같게
SERVER_ID=

# ── Node 여러 개 (backend/cluster/README.md) ──
# Redis 주소 (redis://:비번@호스트:6379), 비우면 단일 Node 모드(예전과 같음)
REDIS_URL=
# Redis 키·채널 앞머리 (비우면 mmc, e2e는 e2e:<RUN_ID>)
REDIS_KEY_PREFIX=
# 배포 생성기만 읽는 Node 수 (비우면 코어 수), 서버는 DB 풀 합 경고에만 씀
NODE_COUNT=
# MySQL max_connections (비우면 151), Node 수 × DB_POOL_MAX가 이 값의 80%를 넘으면 켤 때 경고
DB_MAX_CONNECTIONS=
# 하트비트 주기·죽음 판정 (ms, 비우면 3000 / 10000)
CLUSTER_HEARTBEAT_MS=
NODE_DEAD_AFTER_MS=
# Node끼리 묻고 답 기다리는 시간 (ms, 비우면 1500)
CLUSTER_RPC_TIMEOUT_MS=
# Redis 상태 확인 주기·시간 초과·켤 때 첫 연결 기다림 (ms, 비우면 2000 / 1000 / 2000)
CLUSTER_HEALTH_INTERVAL_MS=
CLUSTER_HEALTH_TIMEOUT_MS=
CLUSTER_CONNECT_WAIT_MS=
# 점검·금칙어 안전망 다시 읽기 주기 (ms, 비우면 60000)
OPS_RELOAD_INTERVAL_MS=
# 접속 끊김(OFFLINE) 알림 미루기 (ms, 비우면 1500, Node 이동 깜빡임 막기)
PRESENCE_OFFLINE_DELAY_MS=
# Redis 죽었을 때 세션 캐시 (ms, 비우면 0 = 끔)
SESSION_CACHE_FALLBACK_MS=

# ── 이메일: Gmail SMTP (MAIL_SMTP_HOST가 있으면 이 방법으로 보냄) ──
# smtp.gmail.com
MAIL_SMTP_HOST=
# 465(처음부터 암호화) 또는 587(STARTTLS), 비우면 465
MAIL_SMTP_PORT=
# 보내는 Gmail 주소
MAIL_SMTP_USER=
# 구글 앱 비밀번호 16자리 (Gmail 로그인 비밀번호 아님)
MAIL_SMTP_PASS=

# ── 이메일: HTTPS 게이트웨이 (MAIL_SMTP_HOST가 비었을 때만, 예: Resend https://api.resend.com/emails) ──
PASSWORD_RESET_MAIL_GATEWAY_URL=
# 게이트웨이 API 키 (Bearer로 보냄)
PASSWORD_RESET_MAIL_GATEWAY_TOKEN=

# ── 이메일 공통 ──
# 보내는 사람 (예: 가면무도회 <보내는주소>), Gmail이면 MAIL_SMTP_USER와 같은 주소
PASSWORD_RESET_MAIL_FROM=
# 메일 보내기 최대 기다림(ms), 비우면 SMTP 10000·게이트웨이 5000
PASSWORD_RESET_MAIL_TIMEOUT_MS=
# 비밀번호 재설정 링크 앞부분 (앱 주소 또는 /password-reset 화면 주소)
PASSWORD_RESET_APP_URL=
# 가입 인증번호 해시용 비밀값 (길고 무작위로)
SIGNUP_EMAIL_HMAC_SECRET=

# ── 토스페이먼츠 (API 개별 연동 키) ──
# 시험 키 (test_ck_·test_sk_): 개발·시험은 이것만 씀, 운영도 운영 키 없으면 이걸로 돎(켤 때 경고)
# 결제창용 클라이언트 키
TOSS_TEST_CLIENT_KEY=
# 결제 승인용 시크릿 키 (서버에만)
TOSS_TEST_SECRET_KEY=
# 운영 키 (live_ck_·live_sk_): NODE_ENV=production일 때만 읽음, 하나라도 넣으면 시험 키 대신 이것만 씀
TOSS_LIVE_CLIENT_KEY=
TOSS_LIVE_SECRET_KEY=
# 보안 키 (웹훅 확인용, 지금 코드는 안 읽음)
TOSS_TEST_SECURITY_KEY=

# ── 소셜 로그인 (안 쓰면 비움) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_TIMEOUT_MS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_LINK_REDIRECT_URI=
DISCORD_OAUTH_TIMEOUT_MS=

# ── 선택: 요청 수 제한·유효 시간 (비우면 기본값) ──
FIND_ID_IP_MAX=
FIND_ID_TARGET_MAX=
FIND_ID_WINDOW_MS=
PASSWORD_RESET_TOKEN_TTL_MS=
PASSWORD_RESET_REQUEST_IP_MAX=
PASSWORD_RESET_REQUEST_EMAIL_MAX=
PASSWORD_RESET_REQUEST_WINDOW_MS=
PASSWORD_RESET_CHECK_IP_MAX=
PASSWORD_RESET_CHECK_WINDOW_MS=
SIGNUP_EMAIL_CODE_LENGTH=
SIGNUP_EMAIL_CODE_TTL_MS=
SIGNUP_EMAIL_RESEND_COOLDOWN_MS=
SIGNUP_EMAIL_MAX_ATTEMPTS=
SIGNUP_EMAIL_PROOF_TTL_MS=
SIGNUP_EMAIL_HOUR_MAX=
SIGNUP_EMAIL_DAY_MAX=
SIGNUP_IP_HOUR_MAX=
SIGNUP_IP_DAY_MAX=
# 로그인·이메일 중복 확인·토큰 갱신·소셜 가입 ip당 요청 수 (기본 10분에 50·20·600·60)
LOGIN_IP_MAX=
LOGIN_IP_WINDOW_MS=
CHECK_EMAIL_IP_MAX=
CHECK_EMAIL_IP_WINDOW_MS=
REFRESH_IP_MAX=
REFRESH_IP_WINDOW_MS=
SOCIAL_SIGNUP_IP_MAX=
SOCIAL_SIGNUP_IP_WINDOW_MS=

# ── 선택: DB 연결 풀·개발용 (비우면 기본값) ──
DB_POOL_MAX=
DB_POOL_MIN=
DB_POOL_ACQUIRE=
DB_POOL_IDLE=
# 개발에서 sequelize 질의를 하나하나 찍어 보려면 1 (운영은 이 값과 상관없이 늘 끔)
DB_LOG_QUERIES=
GAME_DEV_MIN_PLAYERS=
GAME_SOURCE_OVERRIDE=
CONCURRENT_SNAPSHOT_INTERVAL_MS=
NIGHT_PRESENTATION_WAIT_TIMEOUT_MS=
MIGRATION_VERBOSE=

# ── 관리자 서버 내부 API (docs/운영_받침_2026-11-09.md) ──
# 관리자 서버가 X-Internal-Key로 보내는 열쇠, 32자 이상 무작위 (비우면 /internal 전체 꺼짐)
INTERNAL_API_KEY=

# ── 관리자 페이지 /admin-api (docs/관리자-페이지/설계.md 5장) ──
# OTP 비밀 잠금 열쇠, 16진수 64자 (비우면 /admin-api 전체 꺼짐), 바꾸면 계정마다 reset-otp 다시
ADMIN_TOTP_KEY=
# 관리자 화면 주소 (쓰기 요청 Origin 확인), 개발은 http://localhost:5175(npm run dev:admin), 운영은 https://admin.도메인 (비우면 로그인·쓰기 전부 403)
ADMIN_ORIGIN=
# 클라우드플레어 Access 확인: required(기본) / off(개발·시험만, 운영에선 무시)
ADMIN_ACCESS_MODE=
# 클라우드플레어 팀 이름(또는 팀.cloudflareaccess.com) · Access 앱 AUD 값 (운영은 둘 다 없으면 /admin-api 꺼짐)
ADMIN_ACCESS_TEAM_DOMAIN=
ADMIN_ACCESS_AUD=
# 시험용 공개키 주소 (운영에선 무시, 비우면 팀 주소에서 받음)
ADMIN_ACCESS_CERTS_URL=
# 가만히 있으면 자동 로그아웃 분 (비우면 30)
ADMIN_SESSION_IDLE_MIN=

# ── 운영 준비: 로그 파일·부하 시험 (docs/운영_준비_2026-11-09.md · docs/부하시험.md) ──
# 로그 폴더 (비우면 backend/logs, off면 파일 안 남김)
LOG_DIR=
# 로그 보관 일수 (오늘 포함, 비우면 14)
LOG_RETENTION_DAYS=
# 부하 시험이 절대 안 때릴 주소 목록 (쉼표로, 운영 주소 넣기)
LOADTEST_BLOCKED_TARGETS=
# 부하 시험이 /health 서버 숫자·/internal/live 읽을 때 쓰는 열쇠 (서버 INTERNAL_API_KEY와 같은 값)
LOADTEST_INTERNAL_KEY=
# 부하 시험 소켓 Origin 헤더 (서버 FRONTEND_URL과 같게, 비우면 로컬은 그대로·다른 대상은 대상 주소)
LOADTEST_FRONTEND_ORIGIN=
# 관리자 명령(npm run admin)이 부를 서버 주소 (비우면 http://localhost:PORT)
# 운영은 비워 두고 서버 안 backend 컨테이너에서 부르기 권장 (클라우드플레어·nginx 안 거침, docs/배포_설정.md 6-7)
ADMIN_CALL_BASE_URL=

# 개발 시험 계정(tester1~4) 비번, scripts/seed-dev-testers.js가 없으면 만들어 넣음
DEV_TESTER_PASSWORD=
