# 백엔드 환경 값 이름 모음 (진짜 값은 backend/.env에만, 이 파일엔 절대 안 넣음)
# 비워 둔 줄은 기본값이 있거나 그 기능을 안 쓸 때 비워도 됨. 설정 방법: docs/이메일_토스_설정.md

# ── 서버 기본 ──
# 서버 포트
PORT=
# MySQL 주소 (mysql://아이디:비밀번호@호스트:포트/DB이름)
DATABASE_URL=
# 로그인 토큰 서명 비밀값 (길고 무작위로)
JWT_SECRET=
# 데스크톱·모바일 화면 주소 (CORS·소셜 로그인 복귀용)
FRONTEND_URL=
FRONTEND_MOBILE_URL=
# 실행 환경 (development·test·production)
NODE_ENV=

# ── 이메일: Gmail SMTP (MAIL_SMTP_HOST가 있으면 이 방법으로 보냄) ──
# smtp.gmail.com
MAIL_SMTP_HOST=
# 465(처음부터 암호화) 또는 587(STARTTLS), 비우면 465
MAIL_SMTP_PORT=
# 보내는 Gmail 주소
MAIL_SMTP_USER=
# 구글 앱 비밀번호 16자리 (Gmail 로그인 비밀번호 아님)
MAIL_SMTP_PASS=

# ── 이메일: HTTPS 게이트웨이 (MAIL_SMTP_HOST가 비었을 때만, 예: Resend https://api.resend.com/emails) ──
PASSWORD_RESET_MAIL_GATEWAY_URL=
# 게이트웨이 API 키 (Bearer로 보냄)
PASSWORD_RESET_MAIL_GATEWAY_TOKEN=

# ── 이메일 공통 ──
# 보내는 사람 (예: 가면무도회 <보내는주소>), Gmail이면 MAIL_SMTP_USER와 같은 주소
PASSWORD_RESET_MAIL_FROM=
# 메일 보내기 최대 기다림(ms), 비우면 SMTP 10000·게이트웨이 5000
PASSWORD_RESET_MAIL_TIMEOUT_MS=
# 비밀번호 재설정 링크 앞부분 (앱 주소 또는 /password-reset 화면 주소)
PASSWORD_RESET_APP_URL=
# 가입 인증번호 해시용 비밀값 (길고 무작위로)
SIGNUP_EMAIL_HMAC_SECRET=

# ── 토스페이먼츠 (API 개별 연동 키, 시험 키만 받음: test_ck_·test_sk_) ──
# 결제창용 클라이언트 키
TOSS_TEST_CLIENT_KEY=
# 결제 승인용 시크릿 키 (서버에만)
TOSS_TEST_SECRET_KEY=
# 보안 키 (웹훅 확인용, 지금 코드는 안 읽음)
TOSS_TEST_SECURITY_KEY=

# ── 소셜 로그인 (안 쓰면 비움) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_TIMEOUT_MS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_LINK_REDIRECT_URI=
DISCORD_OAUTH_TIMEOUT_MS=

# ── 선택: 요청 수 제한·유효 시간 (비우면 기본값) ──
FIND_ID_IP_MAX=
FIND_ID_TARGET_MAX=
FIND_ID_WINDOW_MS=
PASSWORD_RESET_TOKEN_TTL_MS=
PASSWORD_RESET_REQUEST_IP_MAX=
PASSWORD_RESET_REQUEST_EMAIL_MAX=
PASSWORD_RESET_REQUEST_WINDOW_MS=
PASSWORD_RESET_CHECK_IP_MAX=
PASSWORD_RESET_CHECK_WINDOW_MS=
SIGNUP_EMAIL_CODE_LENGTH=
SIGNUP_EMAIL_CODE_TTL_MS=
SIGNUP_EMAIL_RESEND_COOLDOWN_MS=
SIGNUP_EMAIL_MAX_ATTEMPTS=
SIGNUP_EMAIL_PROOF_TTL_MS=
SIGNUP_EMAIL_HOUR_MAX=
SIGNUP_EMAIL_DAY_MAX=
SIGNUP_IP_HOUR_MAX=
SIGNUP_IP_DAY_MAX=

# ── 선택: DB 연결 풀·개발용 (비우면 기본값) ──
DB_POOL_MAX=
DB_POOL_MIN=
DB_POOL_ACQUIRE=
DB_POOL_IDLE=
GAME_DEV_MIN_PLAYERS=
GAME_SOURCE_OVERRIDE=
CONCURRENT_SNAPSHOT_INTERVAL_MS=
NIGHT_PRESENTATION_WAIT_TIMEOUT_MS=
MIGRATION_VERBOSE=

# ── 관리자 서버 내부 API (docs/운영_받침_2026-11-09.md) ──
# 관리자 서버가 X-Internal-Key로 보내는 열쇠, 32자 이상 무작위 (비우면 /internal 전체 꺼짐)
INTERNAL_API_KEY=

# ── 운영 준비: 로그 파일·부하 시험 (docs/운영_준비_2026-11-09.md · docs/부하시험.md) ──
# 로그 폴더 (비우면 backend/logs, off면 파일 안 남김)
LOG_DIR=
# 로그 보관 일수 (오늘 포함, 비우면 14)
LOG_RETENTION_DAYS=
# 부하 시험이 절대 안 때릴 주소 목록 (쉼표로, 운영 주소 넣기)
LOADTEST_BLOCKED_TARGETS=
# 부하 시험이 /health 서버 숫자·/internal/live 읽을 때 쓰는 열쇠 (서버 INTERNAL_API_KEY와 같은 값)
LOADTEST_INTERNAL_KEY=
