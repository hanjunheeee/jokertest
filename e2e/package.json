{
  "name": "mmc-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "진짜 브라우저로 누르는 시험 (Playwright) — 시험 전용 DB joker_e2e·포트 4100/5273/5274",
  "scripts": {
    "db:setup": "node scripts/setup-db.js",
    "db:reset": "node scripts/setup-db.js --reset",
    "test": "playwright test",
    "test:fast": "playwright test --grep-invert @game",
    "test:game": "playwright test --grep @game",
    "test:safari": "playwright test --project=mobile-safari",
    "test:shutdown": "playwright test --project=shutdown",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
