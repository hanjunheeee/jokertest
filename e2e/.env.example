# e2e 실행 설정 예시. 이 파일을 e2e/.env로 복사한 뒤 실제 값을 채우세요.
# e2e/.env는 커밋되지 않습니다(루트 .gitignore의 **/.env).

# frontend dev 서버 주소. 생략하면 http://localhost:5173 을 씁니다.
E2E_BASE_URL=http://localhost:5173

# 테스트 계정 5개. 좌석 순서가 곧 역할입니다(입장 순서대로 배정됩니다).
#   USER1 = JOKER / USER2 = DOCTOR / USER3 = GUARD / USER4 = WITCH_HUNTER / USER5 = CITIZEN
# NICKNAME은 회원가입 때 쓴 실제 닉네임과 정확히 같아야 하며, 5개가 서로 달라야 합니다
# (스크립트가 닉네임으로 좌석을 구분합니다).
E2E_USER1_EMAIL=joker@example.com
E2E_USER1_PASSWORD=change-me
E2E_USER1_NICKNAME=테스터1

E2E_USER2_EMAIL=doctor@example.com
E2E_USER2_PASSWORD=change-me
E2E_USER2_NICKNAME=테스터2

E2E_USER3_EMAIL=guard@example.com
E2E_USER3_PASSWORD=change-me
E2E_USER3_NICKNAME=테스터3

E2E_USER4_EMAIL=witchhunter@example.com
E2E_USER4_PASSWORD=change-me
E2E_USER4_NICKNAME=테스터4

E2E_USER5_EMAIL=citizen@example.com
E2E_USER5_PASSWORD=change-me
E2E_USER5_NICKNAME=테스터5
