# 환경 변수 (비밀·로컬 전용 — 커밋하지 않음)
.env
**/.env
.env.*
!.env.example
!**/.env.example
# backend 테스트 전용 더미 값(비밀 없음) — CI/다른 개발 환경에서도 npm test가
# 실제 DATABASE_URL 없이 동작하도록 커밋 대상에서 예외로 둔다.
!backend/.env.test

# Claude Code 개인 로컬 설정
.claude/settings.local.json

node_modules

.DS_Store
.pluto/
.aidev/slices/
backend/node_modules/

tmp/

# 로그 (debug.log 등)
*.log

# 빌드 결과물·커버리지
dist/
build/
coverage/

# 편집기 설정
.vscode/
.idea/

# 개인 학습 자료·보고서·임시 출력 (저장소에 안 올림)
reports/
.tours/
output/

# 작업 도구 기록·임시 폴더
.aidev/
.claude/worktrees/
frontend/.tmp-*/

# 원본 MOV(100MB+ 가능) — 런타임은 video-direction/*.mp4 만 사용
frontend/public/video-direction/*.mov
